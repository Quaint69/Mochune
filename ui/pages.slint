component VideoGrid inherits Rectangle {
    in property <[PageRow]> rows;
    in property <int> row-limit: 120;
    in property <length> scroll-y;
    in property <length> page-y;
    in property <length> view-height;
    property <int> columns: max(1, min(6, floor((self.width + 18px) / 298px)));
    property <int> row-count: min(root.row-limit, ceil(root.rows.length / root.columns));
    property <length> tile-width: (self.width - (root.columns - 1) * 18px) / root.columns;
    property <length> row-height: root.tile-width * 9 / 16 + 122px;
    height: root.row-count * root.row-height;
    // Keep the visible rows and exactly one row ahead. Notify once per row
    // boundary, not once per recycled cell or per scrolling pixel.
    property <length> view-top: -(root.scroll-y + root.page-y);
    property <int> art-first: max(0, min(root.row-count, floor(root.view-top / root.row-height)));
    property <int> art-end: max(0, min(root.row-count, ceil((root.view-top + root.view-height) / root.row-height) + 1));
    property <int> art-epoch: BrowsePages.art-epoch;
    function schedule-art() { art-settle.running = true; art-settle.restart(); }
    changed art-first => { root.schedule-art(); }
    changed art-end => { root.schedule-art(); }
    changed columns => { root.schedule-art(); }
    changed art-epoch => { root.schedule-art(); }
    init => { root.schedule-art(); }
    art-settle := Timer {
        interval: 16ms; running: false;
        triggered => {
            self.running = false;
            BrowsePages.artwork-window(root.art-first * root.columns, min(root.rows.length, root.art-end * root.columns));
        }
    }
    property <int> pool-rows: min(root.row-count, max(1, ceil(root.view-height / root.row-height) + 2));
    property <int> first-row: max(0, min(root.row-count - root.pool-rows, floor(-(root.scroll-y + root.page-y) / root.row-height) - 1));
    for slot in root.pool-rows: Rectangle {
        property <int> feed-row: root.first-row + mod(slot - mod(root.first-row,root.pool-rows) + root.pool-rows,root.pool-rows);
        y: self.feed-row * root.row-height; height: root.row-height; width: parent.width;
        for column in root.columns: VideoTile {
            x: column * (root.tile-width + 18px); y: 0px; width: root.tile-width;
            visible: column < root.columns && parent.feed-row * root.columns + column < root.rows.length;
            entry: root.rows[self.visible ? parent.feed-row * root.columns + column : -1];
        }
    }
}
export component PersonalPage inherits ThemeBox {
        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 0px;
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        theme-section: 4; theme-key: "video-page"; theme-kind: "surface";

    property <length> frame-width: self.width;
    property <length> frame-height: self.height;
    changed frame-width => { BrowsePages.artwork-reflow(); }
    changed frame-height => { BrowsePages.artwork-reflow(); }
    property <bool> page-loading: BrowsePages.busy;
    changed page-loading => { if root.page-loading && BrowsePages.page != 1 { body.content-y = 0px; } }
    property <int> home-reset: BrowsePages.home-reset;
    changed home-reset => { body.content-y = BrowsePages.home-scroll; }
    property <bool> empty-home: BrowsePages.page == 1 && !BrowsePages.busy && BrowsePages.rows.length == 0;
    background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (AppColors.window);
    if root.empty-home: ThemeText {
        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
        font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
        theme-section: 4; theme-key: "video-page-text-11"; theme-kind: "text";

        x: 28px; y: 0px; width: max(0px, parent.width - 56px); height: parent.height;
        text: BrowsePages.status != "" ? BrowsePages.status : "Search for a video to get started.";
        color: self.theme-paint.has-text ? self.theme-paint.text : (AppColors.muted); font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (18px); wrap: word-wrap;
        horizontal-alignment: center; vertical-alignment: center;
    }
    VerticalBox {
        visible: true;
        padding: 0px; spacing: 14px;
