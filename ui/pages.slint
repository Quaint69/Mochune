export component CommentsPanel inherits ThemeBox {
        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 0px;
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        theme-section: 4; theme-key: "video-page-surface-24"; theme-kind: "surface";

    property <int> shown: 8;
    property <[CommentRow]> comment-rows: BrowsePages.comments;
    changed comment-rows => { root.shown = 8; }
    property <bool> loading: BrowsePages.comments-busy;
    changed loading => { if root.loading { root.shown = 8; } }
    height: content.preferred-height;
    background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (transparent);
    content := VerticalBox {
        width: parent.width; padding: 0px; spacing: 12px;

        if BrowsePages.comments-open && BrowsePages.comments-busy: LoadingDots { }
        if BrowsePages.comments-open && BrowsePages.comments-status != "": ThemeText {
        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
        font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
        theme-section: 4; theme-key: "video-page-text-20"; theme-kind: "text";

            text: BrowsePages.comments-status; color: self.theme-paint.has-text ? self.theme-paint.text : (AppColors.muted); font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (12px); wrap: word-wrap;
        }
        if BrowsePages.comments-open: VerticalBox {
            padding: 0px; spacing: 10px;
            for index in min(root.shown, root.comment-rows.length): CommentCard { entry: root.comment-rows[index]; }
            if root.shown < root.comment-rows.length: PageAction {
                label: "Show more"; clicked => { root.shown = min(root.comment-rows.length, root.shown + 8); }
            }
        }
    }
}
