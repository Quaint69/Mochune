                                width: 28px;
                                height: 28px;
                                active: root.song-liked(root.selected-id, root.likes-revision);
                                skinned: true;
                                skin-slot: 14;
                                label: "Like / unlike song";
                                available: root.has-selection;
                                clicked=>{
                                    root.toggle-like(-1);
                                }
