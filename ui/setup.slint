                            }
                        }
                    }
                    CornerCutouts {
                        visible: !MusicTheme.enabled(2); width: parent.width; height: parent.height;
                        radius: 12px; outside: AppColors.window;
                    }
                }
                music-player := ThemeBox {
                    opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                    theme-section: 3;
                    theme-key: "music-player";
                    theme-kind: "surface";
                    theme-state: "normal";
                    width: root.compact-music ? root.width - 40px : 336px;
                    min-height: 0px;
                    preferred-height: 0px;
                    vertical-stretch: 1;
                    background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (MusicSkin.panel);
                    border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (MusicSkin.enabled ? MusicSkin.radius * 1px : 12px);
                    border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : (MusicSkin.enabled ? MusicSkin.border-width * 1px : 0px);
                    border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : (MusicSkin.border);
                    if MusicSkin.enabled: SkinImage {
                        theme-section: 3;
                        theme-key: "panel-artwork";
                        theme-kind: "panel-artwork";
                        slot: 0;
                        x: MusicSkin.border-width * 1px;
                        y: self.x;
                        width: parent.width - 2*self.x;
                        height: parent.height - 2*self.y;
                    }
                    property <length> available-height: root.height - (root.compact-music ? 90px : 94px) - (root.offline ? 52px : 0px);
                    property <length> available-width: root.compact-music ? root.width - 40px : 336px;
                    changed extra-visible=>{
                        root.skin-card-visible=self.extra-visible;
                    }
                    init=>{
                        root.skin-card-visible=self.extra-visible;
                    }
                    // Give disabled lyrics' space back to artwork/card, but never hide playback errors.
                    property <length> lyrics-reserved-height: root.lyrics-enabled ? 128px : root.player-error != "" ? 42px : 0px;
                    property <length> lyrics-reserved-space: self.lyrics-reserved-height > 0px ? self.lyrics-reserved-height + 8px : 0px;
                    property <bool> extra-visible: root.music-extra-card && music-scroll.visible-height >= music-scroll.visible-width + 212px;
                    property <length> extra-height: root.lyrics-enabled ? 144px : max(144px,music-scroll.visible-height - music-scroll.visible-width - 68px);
                    VerticalBox {
                        padding: 16px;
