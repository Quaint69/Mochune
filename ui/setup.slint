                                                    source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (@image-url("icons/music.svg"));
                                                    colorize: self.theme-paint.image.width > 0 ? transparent : self.theme-paint.has-tint ? self.theme-paint.tint : (AppColors.muted);
                                                    width: (20px) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                                    height: (20px) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                                    x: (14px) + self.theme-paint.offset-x * 1px;
                                                    y: (14px) + self.theme-paint.offset-y * 1px;
                                                    image-fit: contain;
