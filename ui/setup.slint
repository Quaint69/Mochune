                                                ThemeImage {
                                                    image-rendering: self.theme-paint.pixelated ? pixelated : smooth;
                                                    colorize: self.theme-paint.image.width > 0 ? transparent : self.theme-paint.has-tint ? self.theme-paint.tint : transparent;
                                                    theme-section: 2;
                                                    theme-key: "list-icon-3";
                                                    theme-kind: "icon";
                                                    theme-state: "normal";
                                                    source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (song.thumbnail);
                                                    image-fit: cover;
                                                    width: (parent.width) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                                    height: (parent.height) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                                }
                                                if song.downloaded: ThemeBox {
                                                    opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                                    border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
                                                    border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
                                                    theme-section: 2;
                                                    theme-key: "list-surface-7";
                                                    theme-kind: "surface";
                                                    theme-state: "normal";
                                                    x: 33px;
                                                    y: 33px;
                                                    width: 15px;
                                                    height: 15px;
                                                    background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (AppColors.panel);
                                                    border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (3px);
                                                    ThemeImage {
