    forward-focus: shortcuts;
    // The outer window stays opaque and square in every mode.
    Rectangle { width: root.width; height: root.height; border-radius: 0px; background: root.window-fill; }
    shortcuts := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        key-pressed(event) => {
            if root.browsing-page {
                if event.text == Key.Escape { BrowsePages.close-page(); return accept; }
                return reject;
            }
            if root.theme-preview && (event.text == "r" || event.text == "R") {
                root.skin-reload();
                return accept;
            }
            if root.native-video-enabled && root.video-visible && root.native-player-key(event.text) {
                return accept;
            }
            if event.text == Key.Escape && root.playlist-editor {
                root.playlist-editor=false;
                return accept;
            }
            if event.text == Key.Escape && root.download-open {
                root.download-open=false;
                return accept;
            }
            if event.text == Key.Escape && root.settings-open {
                root.cancel-settings();
                return accept;
            }
            if event.text == Key.Escape && root.fullscreen-mode {
                root.toggle-fullscreen();
                return accept;
            }
            if Sources.mode == 3 && !root.settings-open && !root.download-open {
                if event.text == Key.RightArrow {Sources.turn-page(1);return accept;}
                if event.text == Key.LeftArrow {Sources.turn-page(-1);return accept;}
                if event.text=="-" || event.text=="_" {Sources.zoom=max(0.25,Sources.zoom - 0.1);return accept;}
                if event.text=="+" || event.text=="=" {Sources.zoom=min(3,Sources.zoom+0.1);return accept;}
                if event.text == " " {return accept;}
            }
            if !root.settings-open && !root.download-open && event.text == "f" {
                root.toggle-fullscreen();
                return accept;
            }
            if !root.settings-open && !root.download-open && root.duration > 0 && event.text == Key.LeftArrow {
                root.seek(max(0,root.position - 5));
                return accept;
            }
            if !root.settings-open && !root.download-open && root.duration > 0 && event.text == Key.RightArrow {
                root.seek(min(root.duration,root.position + 5));
                return accept;
            }
