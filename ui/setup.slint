                                                        source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (@image-url("icons/download.svg"));
                                                        colorize: self.theme-paint.image.width > 0 ? transparent : self.theme-paint.has-tint ? self.theme-paint.tint : (AppColors.accent);
                                                        width: (11px) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                                        height: (11px) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                                        x: (2px) + self.theme-paint.offset-x * 1px;
                                                        y: (2px) + self.theme-paint.offset-y * 1px;
                                                    }
                                                }
                                            }
                                        }
                                        VerticalBox {
                                            padding: 0px;
