                                                theme-state: "normal";
                                                text: song.music-available ? song.channel + (song.views-text != "" ? " | " + song.views-text : "") : song.unavailable-reason;
                                                color: self.theme-paint.has-text ? self.theme-paint.text : (AppColors.muted);
