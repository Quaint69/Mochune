                                        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
                                        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
                                        theme-section: 3;
                                        theme-key: "player-surface-3";
                                        theme-kind: "surface";
                                        theme-state: "normal";
                                        width: parent.height;
                                        height: parent.height;
                                        x: (parent.width - self.width) / 2;
                                        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (MusicSkin.enabled ? MusicSkin.surface : AppColors.placeholder);
                                        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (MusicSkin.enabled ? MusicSkin.radius * 1px : 10px);
                                        clip: true;
                                        ThemeImage {
                                            image-rendering: self.theme-paint.pixelated ? pixelated : smooth;
                                            theme-section: 3;
                                            theme-key: "music-icon";
                                            theme-kind: "icon";
                                            theme-state: "normal";
                                            source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (@image-url("icons/music.svg"));
                                            colorize: self.theme-paint.image.width > 0 ? transparent : self.theme-paint.has-tint ? self.theme-paint.tint : (MusicSkin.accent-text);
                                            width: (64px) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                            height: (64px) * (self.theme-paint.has-scale ? self.theme-paint.scale : 1);
                                            x: ((parent.width - self.width)/2) + self.theme-paint.offset-x * 1px;
                                            y: ((parent.height - self.height)/2) + self.theme-paint.offset-y * 1px;
                                            image-fit: contain;
                                        }
                                        ThemeImage {
                                            image-rendering: self.theme-paint.pixelated ? pixelated : smooth;
                                            colorize: self.theme-paint.image.width > 0 ? transparent : self.theme-paint.has-tint ? self.theme-paint.tint : transparent;
                                            theme-section: 3;
                                            theme-key: "album-image";
                                            theme-kind: "icon";
                                            theme-state: "normal";
                                            source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (root.selected-image);
                                            image-fit: cover;
                                            x: self.theme-paint.inset * 1px;
                                            y: self.theme-paint.inset * 1px;
                                            width: max(0px,parent.width - self.theme-paint.inset * 2px);
                                            height: max(0px,parent.height - self.theme-paint.inset * 2px);
                                            // hqdefault has a 4:3 canvas; match the list's 16:9 image crop.
                                            source-clip-width: root.selected-image.width;
                                            source-clip-height: root.selected-image.width * 3 == root.selected-image.height * 4 ? round(root.selected-image.width * 9 / 16) : root.selected-image.height;
                                            source-clip-y: max(0, (root.selected-image.height - self.source-clip-height) / 2);
                                        }
                                        if MusicSkin.enabled: SkinImage {
                                            theme-section: 3;
                                            theme-key: "album-frame";
                                            theme-kind: "frame";
                                            slot: 2;
                                            width: parent.width;
                                            height: parent.height;
                                        }
                                        CornerCutouts {
                                            visible: !MusicTheme.enabled(3) && !MusicSkin.enabled;
                                            width: parent.width; height: parent.height;
                                            radius: 10px; outside: MusicSkin.panel;
                                        }
                                    }
                                }
                                ThemeText {
                                    opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                    theme-section: 3;
                                    theme-key: "player-text-2";
                                    theme-kind: "text";
                                    theme-state: "normal";
                                    font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : (MusicSkin.font-family);
                                    text: root.has-selection ? root.selected-title : "Choose a song";
                                    color: self.theme-paint.has-text ? self.theme-paint.text : (MusicSkin.text);
                                    font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (MusicSkin.title-size * 1px);
                                    font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : (700);
                                    wrap: word-wrap;
                                    max-lines: 2;
                                    overflow: clip;
                                    width: music-scroll.visible-width;
                                    height: max(52px, self.preferred-height);
                                    vertical-stretch: 0;
                                    vertical-alignment: top;
                                }
                                if music-player.extra-visible: ThemeBox {
                                    opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                    theme-section: 3;
                                    theme-key: "player-surface-4";
                                    theme-kind: "surface";
                                    theme-state: "normal";
                                    height: music-player.extra-height;
                                    vertical-stretch: 0;
                                    background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (MusicSkin.surface);
                                    border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : (1px);
                                    border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : (MusicSkin.border);
                                    border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (MusicSkin.enabled ? MusicSkin.radius * 1px : 10px);
                                    clip: true;
                                    if MusicSkin.enabled || (MusicSkin.images.length > 1 && MusicSkin.images[1].width > 0): SkinImage {
                                        theme-section: 3;
                                        theme-key: "card-artwork";
                                        theme-kind: "card-artwork";
                                        slot: 1;
                                        width: parent.width;
                                        height: parent.height;
                                    }
                                }
                            }
                        }
                        // Keep enabled lyrics stable while loading/unavailable; release the slot when off.
                        if music-player.lyrics-reserved-height > 0px: ThemeBox {
                            opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                            border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
                            border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
                            border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 0px;
                            theme-section: 3;
                            theme-key: "player-surface-5";
                            theme-kind: "surface";
                            theme-state: "normal";
                            height: music-player.lyrics-reserved-height;
                            vertical-stretch: 0;
                            background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (transparent);
                            clip: true;
                            if root.lyrics-enabled && root.lyrics-available && root.caption-choice > 0: ThemeScrollView {
                                theme-section: 3;
                                theme-key: "lyrics-scroll";
                                width: parent.width;
                                height: parent.height;
                                horizontal-scrollbar-policy: always-off;
                                content-width: self.visible-width;
                                content-height: music-lyrics.height;
                                music-lyrics := LyricsView {
                                    theme-section: 3;
                                    theme-key: "music-lyrics";
                                    width: parent.visible-width;
                                    previous: root.lyric-previous;
                                    current: root.caption-text;
                                    next: root.caption-next;
                                    following: root.lyric-following;
                                    frame: root.lyrics-frame;
                                    animate-step: root.lyrics-animate;
                                }
                            }
                            if root.lyrics-enabled && !root.lyrics-available && root.has-selection && !root.resolving: ThemeText {
                                opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
                                font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                                theme-section: 3;
                                theme-key: "player-text-3";
                                theme-kind: "text";
                                theme-state: "normal";
                                width: parent.width;
                                text: "Lyrics unavailable for this track";
                                color: self.theme-paint.has-text ? self.theme-paint.text : (MusicSkin.muted);
                                font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (11px);
                                wrap: word-wrap;
                            }
                            if root.lyrics-enabled && root.caption-status != "": ThemeText {
                                opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
                                font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                                theme-section: 3;
                                theme-key: "player-text-4";
                                theme-kind: "text";
                                theme-state: "normal";
                                y: parent.height - 32px;
                                width: parent.width;
                                text: root.caption-status;
                                color: self.theme-paint.has-text ? self.theme-paint.text : (MusicSkin.muted);
                                font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (11px);
                                wrap: word-wrap;
                                max-lines: 2;
                                overflow: elide;
                            }
                            if root.player-error != "": ThemeText {
                                opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
                                font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : 14px;
                                font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                                theme-section: 3;
                                theme-key: "player-text-5";
                                theme-kind: "text";
                                theme-state: "normal";
                                y: parent.height - 42px;
                                width: parent.width;
                                text: root.player-error;
                                color: self.theme-paint.has-text ? self.theme-paint.text : (AppColors.error);
                                wrap: word-wrap;
                                overflow: elide;
                                height: 42px;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            height: 24px;
                            SeekBar {
                                theme-section: 3;
                                theme-key: "seek";
                                skinned: true;
                                accent: MusicSkin.played;
                                horizontal-stretch: 1;
                                position: root.position;
                                duration: root.duration;
                                enabled: root.duration > 0 && !root.resolving;
                                seek-requested(target)=>{
                                    root.seek(target);
                                }
                            }
                            ThemeText {
                                opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
                                theme-section: 3;
                                theme-key: "player-text-6";
                                theme-kind: "text";
                                theme-state: "normal";
                                font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : (MusicSkin.font-family);
                                text: root.clock;
                                horizontal-stretch: 0;
                                color: self.theme-paint.has-text ? self.theme-paint.text : (MusicSkin.muted);
                                font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (10px);
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                        MusicTransport {
                            has-selection: root.has-selection; selection-playable: root.selection-playable;
                            resolving: root.resolving; paused: root.paused; position: root.position; duration: root.duration;
                            volume <=> root.volume; previous-volume <=> root.previous-volume; shuffle <=> root.shuffle;
                            repeat: root.repeat; repeat-one: root.repeat-one;
                            lyrics-enabled: root.lyrics-enabled; lyrics-available: root.lyrics-available;
                            lyrics-languages: root.lyrics-languages; lyrics-language-choice: root.lyrics-language-choice;
                            lyrics-language-label: root.lyrics-language-label;
                            toggle-pause=>{ root.toggle-pause(); } play=>{ root.play(); }
                            previous=>{ root.previous(); } next(ended)=>{ root.next(ended); }
                            toggle-music-repeat=>{ root.toggle-music-repeat(); }
                            volume-change(value)=>{ root.volume-change(value); }
                            toggle-lyrics=>{ root.toggle-lyrics(); } choose-caption(index)=>{ root.choose-caption(index); }
                        }
                    }
                }
            }
        }
    }
    if root.mini-music && root.music-layout: mini-player := ThemeBox {
        theme-section: 3; theme-key: "music-player";
        width: root.width; height: root.height; border-radius: 0px;
        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : MusicSkin.panel;
        WindowMoveArea { width: parent.width - 32px; height: parent.height; }
        HorizontalBox {
            x: 0px; y: 0px; width: parent.width - 28px; height: parent.height;
            padding: 8px; spacing: 8px;
            Rectangle {
                width: min(96px,parent.height - 16px); height: self.width;
                background: MusicSkin.surface;
                Image { source: root.selected-image; width: parent.width; height: parent.height; image-fit: cover;
                    source-clip-width: root.selected-image.width;
                    source-clip-height: root.selected-image.width * 3 == root.selected-image.height * 4 ? round(root.selected-image.width * 9 / 16) : root.selected-image.height;
                    source-clip-y: max(0,(root.selected-image.height - self.source-clip-height)/2);
                }
                if root.selected-image.width == 0: Image {
                    source: @image-url("icons/music.svg"); colorize: MusicSkin.muted;
                    width: 32px; height: 32px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                }
                CornerCutouts { width: parent.width; height: parent.height; radius: 9px; outside: mini-player.theme-paint.has-background ? mini-player.theme-paint.background : MusicSkin.panel; }
            }
            VerticalBox {
                padding: 0px; spacing: 6px; alignment: center;
                ThemeText {
                    theme-section: 3; theme-key: "player-text-2";
                    text: root.player-error != "" ? root.player-error : root.has-selection ? root.selected-title : "Choose a song";
                    color: root.player-error != "" ? AppColors.error : MusicSkin.text;
                    font-size: 13px; font-weight: 600; height: 20px; overflow: elide;
                }
                HorizontalBox {
                    padding: 0px; spacing: 6px; height: 20px;
                    SeekBar { theme-section: 3; theme-key: "seek"; skinned: true; accent: MusicSkin.played;
                        position: root.position; duration: root.duration; horizontal-stretch: 1;
                        enabled: root.duration > 0 && !root.resolving;
                        seek-requested(target)=>{ root.seek(target); }
                    }
                    Text { text: root.clock; color: MusicSkin.muted; font-size: 9px; vertical-alignment: center; }
                }
                MusicTransport {
                            tight: true;
                            has-selection: root.has-selection; selection-playable: root.selection-playable;
                            resolving: root.resolving; paused: root.paused; position: root.position; duration: root.duration;
                            volume <=> root.volume; previous-volume <=> root.previous-volume; shuffle <=> root.shuffle;
                            repeat: root.repeat; repeat-one: root.repeat-one;
                            lyrics-enabled: root.lyrics-enabled; lyrics-available: root.lyrics-available;
                            lyrics-languages: root.lyrics-languages; lyrics-language-choice: root.lyrics-language-choice;
                            lyrics-language-label: root.lyrics-language-label;
                            toggle-pause=>{ root.toggle-pause(); } play=>{ root.play(); }
                            previous=>{ root.previous(); } next(ended)=>{ root.next(ended); }
                            toggle-music-repeat=>{ root.toggle-music-repeat(); }
                            volume-change(value)=>{ root.volume-change(value); }
                            toggle-lyrics=>{ root.toggle-lyrics(); } choose-caption(index)=>{ root.choose-caption(index); }
                        }
            }

        }
            VerticalBox {
                x: parent.width - 28px; y: 0px; width: 28px; height: parent.height;
                padding: 0px; spacing: 0px;
                MusicButton { width: 28px; height: root.height / 3; icon-size: 16px;
                    theme-section: 3; theme-key: "mini-restore"; skinned: true;
                    icon: @image-url("icons/restore.svg"); label: "Restore previous window";
                    clicked=>{ root.toggle-mini-music(); }
                }
                MusicButton { width: 28px; height: root.height / 3; icon-size: 16px;
                    theme-section: 3; theme-key: "mini-minimize"; skinned: true;
                    icon: @image-url("icons/minimize.svg"); label: "Minimize"; clicked=>{ root.minimize-window(); }
                }
                MusicButton { width: 28px; height: root.height / 3; icon-size: 16px;
                    theme-section: 3; theme-key: "mini-close"; skinned: true;
                    icon: @image-url("icons/close.svg"); label: "Close"; clicked=>{ root.close(); }
                }
            }
    }
    if root.playlist-editor: ThemeBox {
        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 0px;
        theme-section: 1;
        theme-key: "dialog-surface-1";
        theme-kind: "surface";
        theme-state: "normal";
        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (#090b0fcc);
        TouchArea {
        }
        ThemeBox {
            opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
            theme-section: 1;
            theme-key: "dialog-surface-2";
            theme-kind: "surface";
            theme-state: "normal";
            width: min(420px,root.width - 40px);
            height: root.rename-playlist ? 220px : 184px;
            x: (parent.width - self.width)/2;
            y: (parent.height - self.height)/2;
            background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (AppColors.raised);
            border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : (1px);
            border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : (AppColors.border);
            border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (12px);
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                HorizontalBox {
                    padding: 0px;
                    height: 28px;
                    ThemeText {
                        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                        theme-section: 1;
                        theme-key: "dialog-text-1";
                        theme-kind: "text";
                        theme-state: "normal";
                        text: root.rename-playlist ? "Edit playlist" : "New playlist";
                        color: self.theme-paint.has-text ? self.theme-paint.text : (AppColors.text);
                        font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (18px);
                        font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : (700);
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    MusicButton {
                        theme-section: 1;
                        theme-key: "close-button-1";
                        width: 28px;
                        height: 28px;
                        icon: @image-url("icons/close.svg");
                        icon-size: 16px;
                        label: "Close playlist editor";
                        clicked=>{
                            root.playlist-editor=false;
                        }
                    }
                }
                ThemeBox {
                    theme-section: 1;
                    theme-key: "playlist-name-field";
                    height: 34px;
                    background: AppColors.muted-surface;
                    border-radius: 5px;
                    property <ThemePaint> field-paint: MusicTheme.enabled(1) ? MusicTheme.resolve(1,"playlist-name-input","input","normal",MusicTheme.revision) : {
                    }
                    ;
                    TextInput {
                        x: 10px;
                        width: parent.width - 20px;
                        height: parent.height;
                        text <=> root.playlist-name;
                        single-line: true;
                        vertical-alignment: center;
                        accessible-label: "Playlist name";
                        color: parent.field-paint.has-text ? parent.field-paint.text : AppColors.text;
                        font-family: parent.field-paint.has-font-family ? parent.field-paint.font-family : "DejaVu Sans";
                        font-size: parent.field-paint.has-font-size ? parent.field-paint.font-size * 1px : 14px;
                        accepted=>{
                            if root.rename-playlist {
                                root.playlist-rename(root.playlist-name);
                            }
                            else {
                                root.playlist-create(root.playlist-name);
                            }
                        }
                    }
                }
                if root.rename-playlist: ThemeText {
                    theme-section: 1;
                    theme-key: "playlist-removal-note";
                    text: "Removing this playlist keeps your other playlists.";
                    color: self.theme-paint.has-text ? self.theme-paint.text : AppColors.muted;
                    font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : 11px;
                    wrap: word-wrap;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    height: 34px;
                    ActionButton {
                        theme-section: 1;
                        theme-key: "playlist-save";
                        label: root.rename-playlist ? "Save" : "Create";
                        primary: true;
                        available: root.playlist-name != "";
                        clicked=>{
                            if root.rename-playlist {
                                root.playlist-rename(root.playlist-name);
                            }
                            else {
                                root.playlist-create(root.playlist-name);
                            }
                        }
                    }
                    ActionButton {
                        theme-section: 1;
                        theme-key: "playlist-cancel";
                        label: "Cancel";
                        clicked=>{
                            root.playlist-editor=false;
                        }
                    }
                    if root.rename-playlist: ActionButton {
                        theme-section: 1;
                        theme-key: "playlist-delete";
                        label: "Delete playlist";
                        danger: true;
                        clicked=>{
                            root.playlist-delete();
                        }
                    }
                }
            }
        }
    }
    if root.settings-open: Rectangle {
        background: #090b0fcc;
        TouchArea {
        }
        Rectangle {
            width: min(parent.width - 70px, 820px);
            height: min(parent.height - 60px, 580px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: AppColors.raised;
            border-radius: 12px;
            VerticalBox {
                padding: 22px;
                spacing: 14px;
                Text {
                    text: "Settings";
                    color: AppColors.text;
                    font-size: 24px;
                    font-weight: 700;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 18px;
                    min-height: 0px;
                    vertical-stretch: 1;
                    Rectangle {
                        width: 176px;
                        background: AppColors.window;
                        border-radius: 8px;
                        VerticalBox {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            padding: 8px;
                            spacing: 4px;
                            alignment: start;
                            for tab[index] in ["General", "Themes", "Audio Effects", "Recommendations", "Storage", "Playlists", "About"]: Rectangle {
                                height: 36px;
                                border-radius: 6px;
                                background: root.settings-tab == (index == 0 ? 0 : index == 1 ? 5 : index == 2 ? 6 : index - 2) ? AppColors.selected : nav-hit.has-hover ? AppColors.hover : transparent;
                                Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: tab;
                                    color: AppColors.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    font-size: 13px;
                                    font-weight: root.settings-tab == (index == 0 ? 0 : index == 1 ? 5 : index == 2 ? 6 : index - 2) ? 700 : 400;
                                }
                                nav-hit := TouchArea {
                                    clicked=>{
                                        root.settings-tab=index == 0 ? 0 : index == 1 ? 5 : index == 2 ? 6 : index - 2;
                                    }
                                }
                            }
                        }
                    }
                    VerticalBox {
                        padding: 0px;
                        spacing: 12px;
                        min-height: 0px;
                        horizontal-stretch: 1;
                        Rectangle {
                            min-height: 0px;
                            preferred-height: 0px;
                            vertical-stretch: 1;
                            clip: true;
                            settings-scroll := ScrollView {
                                width: parent.width;
                                height: parent.height;
                                horizontal-scrollbar-policy: always-off;
                                content-y <=> root.settings-scroll-offset;
                                content-height: max(settings-layout.height, settings-end.y + settings-end.height) + 64px;
                                content-width: self.visible-width;
                                changed content-height=>{
                                    root.settings-content-height=self.content-height;
                                }
                                changed absolute-position => { root.settings-viewport-bottom=self.absolute-position.y+self.visible-height; }
                                changed visible-height=>{
                                    root.settings-visible-height=self.visible-height;
                                    root.settings-viewport-bottom=self.absolute-position.y+self.visible-height;
                                }
                                settings-layout := VerticalBox {
                                    x: 0px; y: 0px;
                                    width: settings-scroll.visible-width - 16px;
                                    height: max(self.preferred-height, self.min-height);
                                    padding: 0px;
                                    spacing: 12px;
                                    alignment: start;
                                    if root.settings-tab == 0: VerticalBox {
                                        padding: 0px;
                                        spacing: 16px;
                                        alignment: start;
                                        vertical-stretch: 0;
                                        CheckBox {
                                            text: "Remember video and music histories";
                                            checked <=> root.remember;
                                        }
                                        Rectangle {
                                            height: gpu-status.preferred-height + 24px;
                                            background: AppColors.window;
                                            border-radius: 8px;
                                            gpu-status := VerticalBox {
                                                x: 12px;
                                                y: 12px;
                                                width: parent.width - 24px;
                                                padding: 0px;
                                                spacing: 6px;
                                                alignment: start;
                                                Text {
                                                    text: "Hardware acceleration";
                                                    color: AppColors.text;
                                                    font-weight: 600;
                                                }
                                                Text {
                                                    text: root.graphics-info == "" ? "Renderer: waiting for graphics setup" : "Renderer: " + root.graphics-info;
                                                    color: AppColors.muted;
                                                    wrap: word-wrap;
                                                    font-size: 12px;
                                                }
                                                Text {
                                                    text: root.hardware-support;
                                                    color: AppColors.muted;
                                                    wrap: word-wrap;
                                                    font-size: 11px;
                                                }
                                                Text {
                                                    text: root.acceleration-status;
                                                    color: root.acceleration-verified ? #56c48b : AppColors.muted;
                                                    wrap: word-wrap;
                                                    font-weight: 600;
                                                    font-size: 12px;
                                                }
                                                if root.acceleration-details != "": Text {
                                                    text: root.acceleration-details;
                                                    color: AppColors.muted;
                                                    wrap: word-wrap;
                                                    font-size: 11px;
                                                }
                                                if !root.interpolation-supported: Text {
                                                    text: "Frame interpolation is unavailable on this platform.";
                                                    color: AppColors.muted; wrap: word-wrap; font-size: 11px;
                                                }
                                                if root.interpolation-supported: CheckBox {
                                                    text:"Automatically disable interpolation when GPU is slow";
                                                    checked <=> root.interpolation-auto-fallback;
                                                }
                                                if root.interpolation-mode>0: Text {
                                                    text:root.interpolation-status;color:AppColors.muted;wrap:word-wrap;font-size:11px;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: AppColors.border;
                                        }
                                        CheckBox {
                                            text: "Use legacy quality picker";
                                            checked <=> root.legacy-quality;
                                        }
                                        CheckBox {
                                            text: "Launch maximized";
                                            checked <=> root.launch-maximized;
                                        }

                                        CheckBox {
                                            text: "Immersive window (hide system title bar)";
                                            checked <=> root.immersive;
                                        }

                                    }
                                    if root.settings-tab == 6: VerticalBox {
                                        padding: 0px; spacing: 16px; alignment: start; vertical-stretch: 0;
                                        Text { text: "Audio Effects"; color: AppColors.text; font-size: 18px; font-weight: 700; }
                                        CheckBox { text: "Channel delay"; checked <=> root.audio-delay-enabled; }
                                        HorizontalBox {
                                            padding: 0px; spacing: 12px;
                                            ComboBox { model: ["Left", "Right"]; current-index <=> root.audio-delay-channel; enabled: root.audio-delay-enabled; width: 110px; horizontal-stretch: 0; }
                                            Slider { minimum: 0; maximum: 20; step: 0.1; value <=> root.audio-delay-ms; enabled: root.audio-delay-enabled; }
                                            Text { text: round(root.audio-delay-ms * 10) / 10 + " ms"; width: 64px; color: AppColors.muted; vertical-alignment: center; }
                                        }
                                        Rectangle { height: 1px; background: AppColors.border; }
                                        CheckBox { text: "Convolver"; checked <=> root.audio-convolver-enabled; }
                                        ComboBox {
                                            model: ["Oxy (bundled)", "Custom file", "Downloaded collection"];
                                            current-index <=> root.audio-impulse-source;
                                            selected(value) => { root.audio-source-change(self.current-index); }
                                        }
                                        if root.audio-impulse-source == 1: VerticalBox {
                                            padding: 0px; spacing: 10px;
                                            Text { text: root.audio-impulse-path == "" ? "Choose an impulse file" : root.audio-impulse-path; overflow: elide; color: AppColors.text; font-size: 13px; }
                                            Button { text: "Choose .irs / .wav"; clicked => { root.pick-audio-impulse(); } }
                                        }
                                        if root.audio-impulse-source == 2: VerticalBox {
                                            padding: 0px; spacing: 10px;
                                            HorizontalBox {
                                                padding: 0px; spacing: 10px;
                                                Button { text: root.audio-collection-downloading ? "Downloading…" : "Download IRS collection"; enabled: !root.audio-collection-downloading; clicked => { root.download-audio-collection(); } }
                                                if root.audio-collection-downloading: Button { text: "Cancel"; clicked => { root.cancel-audio-collection(); } }
                                            }
                                            Text { text: root.audio-collection-status; color: AppColors.muted; wrap: word-wrap; font-size: 12px; }
                                            LineEdit { placeholder-text: "Filter impulses…"; text <=> root.audio-collection-filter; }
                                            ComboBox {
                                                model: root.audio-collection-titles;
                                                current-index <=> root.audio-collection-choice;
                                                enabled: root.audio-collection-titles.length > 0;
                                                selected(value) => { root.select-audio-collection(self.current-index); }
                                            }
                                        }
                                        Text { text: root.audio-impulse-status; color: AppColors.muted; wrap: word-wrap; font-size: 12px; }
                                        HorizontalBox {
                                            padding: 0px; spacing: 12px;
                                            Text { text: "Output"; width: 64px; color: AppColors.text; vertical-alignment: center; }
                                            Slider { minimum: -24; maximum: 0; step: 0.5; value <=> root.audio-convolver-gain; enabled: root.audio-convolver-enabled; }
                                            Text { text: round(root.audio-convolver-gain * 10) / 10 + " dB"; width: 64px; color: AppColors.muted; vertical-alignment: center; }
                                        }
                                        Text { text: "Mono/stereo WAV impulses · up to 5 seconds and 8 MiB. External files stay in their original location."; color: AppColors.muted; wrap: word-wrap; font-size: 12px; }
                                        Text { text: "Save to apply. Playback resumes at the current position. Disabled effects use no DSP buffers."; color: AppColors.muted; wrap: word-wrap; font-size: 12px; }
                                    }
                                    if root.settings-tab == 5: VerticalBox {
                                        padding: 0px; spacing: 14px; alignment: start; vertical-stretch: 0;
                                        CheckBox {
                                            text: "Show empty card in music player";
                                            checked <=> root.music-extra-card;
                                        }
                                        Text {
                                            text: "Theme";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        ComboBox {
                                            height: 34px;
                                            vertical-stretch: 0;
                                            model: ["Dark", "Light"];
                                            current-index: root.light-mode ? 1 : 0;
                                            selected(value)=>{
                                                root.light-mode=self.current-index == 1;
                                            }
                                        }
                                        Text {
                                            text: "Theme · Experimental";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        ComboBox {
                                            height: 34px;
                                            model: root.skin-names;
                                            current-index: root.music-skin-choice;
                                            selected(v)=>{
                                                root.music-skin-choice=self.current-index;
                                            }
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 8px;
                                            ActionButton {
                                                label: "Open folder";
                                                clicked=>{ root.open-themes-folder(); }
                                            }
                                            ActionButton {
                                                label: "Rescan themes";
                                                clicked=>{
                                                    root.skin-open();
                                                }
                                            }
                                            ActionButton {
                                                label: "Reload skin";
                                                clicked=>{
                                                    root.skin-reload();
                                                }
                                            }
                                        }
                                        skin-preview := Rectangle {
                                            property <bool> on-screen: self.absolute-position.y + self.height > settings-scroll.absolute-position.y && self.absolute-position.y < settings-scroll.absolute-position.y + settings-scroll.visible-height;
                                            changed on-screen=>{
                                                root.skin-preview-in-view=self.on-screen;
                                            }
                                            init=>{
                                                root.skin-preview-in-view=self.on-screen;
                                            }
                                            height: 96px;
                                            vertical-stretch: 0;
                                            background: MusicSkin.panel;
                                            border-width: 1px;
                                            border-color: MusicSkin.border;
                                            clip: true;
                                            if MusicSkin.enabled: SkinImage {
                                                slot: 0;
                                                width: parent.width;
                                                height: parent.height;
                                            }
                                            SkinImage {
                                                slot: 1;
                                                width: 128px;
                                                height: 80px;
                                                x: 8px;
                                                y: 8px;
                                            }
                                            Text {
                                                text: "Live skin preview";
                                                font-family: MusicSkin.font-family;
                                                color: MusicSkin.text;
                                                x: 152px;
                                                y: 12px;
                                                width: parent.width - 160px;
                                                height: 24px;
                                                font-size: 13px;
                                                overflow: elide;
                                            }
                                            SkinImage {
                                                slot: 6;
                                                fallback: @image-url("icons/play.svg");
                                                tint: MusicSkin.text;
                                                width: 26px;
                                                height: 26px;
                                                x: 152px;
                                                y: 48px;
                                            }
                                            SkinImage {
                                                slot: 14;
                                                fallback: @image-url("icons/heart.svg");
                                                tint: MusicSkin.liked;
                                                width: 26px;
                                                height: 26px;
                                                x: 196px;
                                                y: 48px;
                                            }
                                        }
                                        CheckBox {
                                            text: "Theme header" + (MusicTheme.available[0] ? "" : " · not provided");
                                            enabled: MusicTheme.available[0];
                                            checked <=> root.theme-header;
                                        }
                                        CheckBox {
                                            text: "Theme library" + (MusicTheme.available[1] ? "" : " · not provided");
                                            enabled: MusicTheme.available[1];
                                            checked <=> root.theme-library;
                                        }
                                        CheckBox {
                                            text: "Theme music list" + (MusicTheme.available[2] ? "" : " · not provided");
                                            enabled: MusicTheme.available[2];
                                            checked <=> root.theme-list;
                                        }
                                        CheckBox {
                                            text: "Theme music player" + (MusicTheme.available[3] ? "" : " · not provided");
                                            enabled: MusicTheme.available[3];
                                            checked <=> root.theme-player;
                                        }
                                        CheckBox {
                                            text: "Animate skin artwork";
                                            checked <=> root.skin-animations;
                                        }
                                        Text {
                                            text: root.skin-status;
                                            color: root.skin-error ? AppColors.error : AppColors.muted;
                                            wrap: word-wrap;
                                            font-size: 11px;
                                        }
                                    }
                                    if root.settings-tab == 5: CheckBox {
                                        text: "Theme video mode" + (MusicTheme.available[4] ? "" : " · not provided");
                                        enabled: MusicTheme.available[4]; checked <=> root.theme-video;
                                    }

                                    if root.settings-tab == 4: VerticalBox {
                                        padding: 0px;
                                        spacing: 14px;
                                        alignment: start;
                                        vertical-stretch: 0;
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 14px;
                                            Image {
                                                source: @image-url("assets/logo-128.png");
                                                width: 56px;
                                                height: 56px;
                                                image-fit: contain;
                                            }
                                            VerticalBox {
                                                padding: 0px;
                                                spacing: 3px;
                                                alignment: center;
                                                Text {
                                                    text: "Mochune";
                                                    color: AppColors.text;
                                                    font-family: "Mochune Display";
                                                    font-size: 27px;
                                                }
                                                Text {
                                                    text: root.about-version;
                                                    color: AppColors.muted;
                                                    font-size: 12px;
                                                }
                                            }
                                        }
                                        Text {
                                            text: "A low-RAM, fast app for YouTube music and videos, anime and movie streaming, and reading manga.";
                                            color: AppColors.muted;
                                            wrap: word-wrap;
                                        }
                                        Button {
                                            text: "github.com/Quaint69/Mochune ↗";
                                            clicked=>{
                                                root.about-link(0);
                                            }
                                        }
                                        Text {
                                            text: "Support Mochune";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 8px;
                                            ActionButton {
                                                label: "Donate with PayPal ↗";
                                                clicked=>{ root.about-link(2); }
                                            }
                                            ActionButton {
                                                label: root.kofi-available ? "Ko-fi ↗" : "Ko-fi · Coming soon";
                                                available: root.kofi-available;
                                                clicked=>{ root.about-link(3); }
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: AppColors.border;
                                        }
                                        Text {
                                            text: "Free & open source";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "GNU General Public License v3 only (GPL-3.0-only). You may use, study, modify and share Mochune under its license. Provided without warranty.";
                                            color: AppColors.muted;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 8px;
                                            Button {
                                                text: "App license";
                                                clicked=>{
                                                    root.show-license(1);
                                                }
                                            }
                                            Button {
                                                text: "Third-party notices";
                                                clicked=>{
                                                    root.show-license(2);
                                                }
                                            }
                                        }
                                        Button {
                                            text: "Dependency license inventory ↗";
                                            clicked=>{
                                                root.about-link(1);
                                            }
                                        }
                                        Text {
                                            text: "Independent project; not affiliated with YouTube or other media providers. History and playlists are stored locally. Content availability depends on third-party sources, and media rights remain with their owners.";
                                            color: AppColors.muted;
                                            wrap: word-wrap;
                                            font-size: 11px;
                                        }
                                        if root.about-license-text != "": Button {
                                            text: "Close license text";
                                            clicked=>{
                                                root.show-license(0);
                                            }
                                        }
                                        if root.about-license-text != "": Text {
                                            text: root.about-license-text;
                                            color: AppColors.muted;
                                            wrap: word-wrap;
                                            font-size: 11px;
                                        }
                                    }
                                    if root.settings-tab == 1: VerticalBox {
                                        padding: 0px;
                                        spacing: 10px;
                                        alignment: start;
                                        vertical-stretch: 0;
                                        Text {
                                            text: "Shape your recommendations";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "Video recommendation limit";
                                            color: AppColors.muted;
                                            font-size: 12px;
                                        }
                                        ComboBox {
                                            height: 32px;
                                            model: ["Up to 25 videos", "Up to 30 videos", "Up to 40 videos", "Up to 50 videos"];
                                            current-index <=> root.recommendation-count;
                                        }
                                        Text {
                                            text: "Music For You: up to 40 songs, 1–10 minutes each.";
                                            color: AppColors.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Minimum recommendation views";
                                            color: AppColors.muted;
                                        }
                                        ComboBox {
                                            model: ["10,000 views", "20,000 views", "30,000 views", "40,000 views", "50,000 views"];
                                            current-index <=> root.minimum-views;
                                        }
                                        CheckBox {
                                            text: "Refresh suggestions when a video starts";
                                            checked <=> root.auto-related;
                                        }
                                        CheckBox {
                                            text: "Use this mode's recent history for For you";
                                            checked <=> root.use-history;
                                        }
                                        CheckBox {
                                            text: "Hide alternate uploads, covers and remixes of the current video";
                                            checked <=> root.hide-alternate-versions;
                                        }
                                        CheckBox {
                                            text: "Hide items already in this mode's history";
                                            checked <=> root.hide-watched;
                                        }
                                        TermEditor {
                                            title: "Blocked channels";
                                            placeholder: "Add a channel name…";
                                            value <=> root.blocked-channels;
                                            split(v)=>{
                                                return root.split-terms(v);
                                            }
                                            edit(v,t,remove)=>{
                                                return root.edit-terms(v,t,remove);
                                            }
                                        }
                                        TermEditor {
                                            title: "Blocked title words";
                                            placeholder: "Add a word or phrase…";
                                            value <=> root.blocked-keywords;
                                            split(v)=>{
                                                return root.split-terms(v);
                                            }
                                            edit(v,t,remove)=>{
                                                return root.edit-terms(v,t,remove);
                                            }
                                        }
                                        Text {
                                            text: "Video and Music keep separate histories of up to 100 items each. For you uses the last 10 entries in the current mode. Results load progressively. Disabling remembered history erases both saved histories and the legacy backup. Filters can leave fewer results.";
                                            wrap: word-wrap;
                                            color: AppColors.muted;
                                            font-size: 12px;
                                        }
                                    }
                                    if root.settings-tab == 3: VerticalBox {
                                        padding: 0px;
                                        spacing: 12px;
                                        alignment: start;
                                        vertical-stretch: 0;
                                        Text {
                                            text: "Playlists · Import & export";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "JSON preserves your library and metadata. M3U8 shares ordered video links with compatible players.";
                                            wrap: word-wrap;
                                            color: AppColors.muted;
                                        }
                                        ComboBox {
                                            model: ["Video playlists", "Music playlists", "All playlists (video + music)"];
                                            current-index <=> root.transfer-scope;
                                        }
                                        Button {
                                            text: "Import playlists…";
                                            width: 210px;
                                            height: 32px;
                                            vertical-stretch: 0;
                                            clicked => {
                                                root.playlist-transfer(true, root.transfer-scope);
                                            }
                                        }
                                        Button {
                                            text: "Export playlists…";
                                            width: 210px;
                                            height: 32px;
                                            vertical-stretch: 0;
                                            clicked => {
                                                root.playlist-transfer(false, root.transfer-scope);
                                            }
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: AppColors.border;
                                        }
                                        Text {
                                            text: "Export one playlist · current mode";
                                            color: AppColors.muted;
                                        }
                                        ComboBox {
                                            height: 32px;
                                            vertical-stretch: 0;
                                            model: root.playlist-names;
                                            current-index <=> root.export-playlist;
                                            enabled: root.playlist-names.length > 0;
                                        }
                                        Button {
                                            text: "Export selected playlist…";
                                            width: 210px;
                                            height: 32px;
                                            vertical-stretch: 0;
                                            enabled: root.playlist-names.length > 0;
                                            clicked => {
                                                root.playlist-export(false);
                                            }
                                        }
                                        Text {
                                            text: "Imports add missing tracks and keep your existing playlists.";
                                            wrap: word-wrap;
                                            color: AppColors.muted;
                                            font-size: 12px;
                                        }
                                    }
                                    if root.settings-tab == 2: VerticalBox {
                                        padding: 0px;
                                        spacing: 12px;
                                        alignment: start;
                                        vertical-stretch: 0;
                                        Text {
                                            text: "Video & audio downloads";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 8px;
                                            LineEdit {
                                                text <=> root.download-folder;
                                                placeholder-text: "Download folder";
                                                horizontal-stretch: 1;
                                            }
                                            Button {
                                                text: "Choose…";
                                                clicked=>{
                                                    root.pick-download-folder();
                                                }
                                            }
                                        }
                                        Text {
                                            text: "Explicit video/audio downloads are kept here, separately from caches. Clearing caches does not delete them.";
                                            color: AppColors.muted;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                        }
                                        CheckBox {
                                            text: "Cache stream links (video + music)";
                                            checked <=> root.stream-cache-enabled;
                                        }
                                        Text {
                                            text: "On by default · Up to 1 MiB in RAM for 3 minutes. Speeds up replay and quality changes; no media is saved.";
                                            color: AppColors.muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        CheckBox {
                                            text: "Cache thumbnails (video + music)";
                                            checked <=> root.cache-enabled;
                                        }
                                        Text {
                                            text: "Off by default · Up to 32 MiB on disk. Turning this off clears saved thumbnails.";
                                            color: AppColors.muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Offline music saving is controlled from Music → Cached.";
                                            color: AppColors.muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            Text {
                                                text: "Completed music limit";
                                                color: AppColors.muted;
                                                vertical-alignment: center;
                                            }
                                            ComboBox {
                                                model: ["128 MiB", "256 MiB", "512 MiB", "1 GiB"];
                                                current-index <=> root.audio-cache-limit;
                                            }
                                        }
                                        Text {
                                            text: "Oldest cached music is removed when space is needed. A partial track may temporarily use extra disk space.";
                                            color: AppColors.muted;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                        Rectangle {
                                            height: 1px;
                                            background: AppColors.border;
                                        }
                                        Text {
                                            text: "Delete cached data";
                                            color: AppColors.text;
                                            font-weight: 600;
                                        }
                                        Text {
                                            text: "Thumbnails and stream links cover video + music. Offline audio covers music only; video files are never cached. Your downloads and playlists are kept.";
                                            color: AppColors.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 8px;
                                            height: 32px;
                                            Button {
                                                text: "Delete thumbnails";
                                                clicked=>{
                                                    root.clear-cache(0);
                                                }
                                            }
                                            Button {
                                                text: "Delete stream links";
                                                clicked=>{
                                                    root.clear-cache(1);
                                                }
                                            }
                                        }
                                        HorizontalBox {
                                            padding: 0px;
                                            spacing: 8px;
                                            height: 32px;
                                            changed absolute-position=>{
                                                root.settings-storage-bottom=self.absolute-position.y+self.height;
                                            }
                                            changed height=>{
                                                root.settings-storage-bottom=self.absolute-position.y+self.height;
                                            }
                                            Button {
                                                text: "Delete cached music";
                                                clicked=>{
                                                    root.clear-cache(2);
                                                }
                                            }
                                            Button {
                                                text: "Delete all caches";
                                                clicked=>{
                                                    root.clear-cache(3);
                                                }
                                            }
                                        }
                                        Text {
                                            text: root.cache-status;
                                            color: AppColors.muted;
                                            wrap: word-wrap;
                                            font-size: 12px;
                                        }
                                    }
                                    settings-end := Rectangle {
                                        height: 1px; vertical-stretch: 0;
                                        changed absolute-position => { root.settings-body-bottom=self.absolute-position.y+self.height; }
                                    }
                                }
                            }
                        }
                        HorizontalBox {
                            padding: 0px;
                            spacing: 8px;
                            height: 34px;
                            vertical-stretch: 0;
                            Button {
                                text: "Save & close";
                                enabled: !root.skin-loading && !root.skin-error;
                                clicked => {
                                    root.save-settings();
                                }
                            }
                            Button {
                                text: "Close";
                                clicked => {
                                    root.cancel-settings();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if root.download-open: ThemeBox {
        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-panel";theme-kind:"surface";
        width: min(root.width - 40px, 460px);
        height: 320px;
        x: root.width - self.width - 20px;
        y: root.fullscreen-mode ? 20px : 72px;
        background: self.theme-paint.has-background ? self.theme-paint.background : AppColors.raised;
        border-radius: self.theme-paint.has-radius ? self.theme-paint.radius*1px : 12px;
        border-width: self.theme-paint.has-border-width ? self.theme-paint.border-width*1px : 1px;
        border-color: self.theme-paint.has-border ? self.theme-paint.border : AppColors.border;
        TouchArea {
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: transparent;
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                HorizontalBox {
                    padding: 0px;
                    height: 28px;
                    ThemeText {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-text";theme-kind:"text";
                        font-family:self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                        text: "Downloads";
                        color:self.theme-paint.has-text ? self.theme-paint.text : AppColors.text;
                        font-size:self.theme-paint.has-font-size ? self.theme-paint.font-size*1px : 18px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    MusicButton {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-close";
                        width: 28px;
                        height: 28px;
                        icon-size: 16px;
                        icon: @image-url("icons/close.svg");
                        label: "Close downloads";
                        clicked=>{
                            root.download-open=false;
                        }
                    }
                }
                ThemeText {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-text";theme-kind:"text";
                        font-family:self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                    text: root.download-title == "" ? "Choose a video, then open Downloads here to choose its quality." : root.download-title;
                    color:self.theme-paint.has-text ? self.theme-paint.text : AppColors.text;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 44px;
                }
                PlaylistPicker {
                    theme-section: root.music-layout ? 0 : 4;
                    theme-key: "downloads-format-picker";
                    changed popup-open=>{root.download-format-open=self.popup-open;}
                    changed popup-x=>{root.download-format-x=self.popup-x;}
                    changed popup-y=>{root.download-format-y=self.popup-y;}
                    changed popup-width=>{root.download-format-width=self.popup-width;}
                    changed popup-height=>{root.download-format-height=self.popup-height;}
                    height: 34px;
                    label: "";
                    placeholder: "Choose a format";
                    accessible-name: "Download format";
                    model: root.download-labels;
                    current-index <=> root.download-choice;
                    available: root.download-ready && !root.download-running && !root.download-preparing;
                }
                ThemeText {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-text";theme-kind:"text";
                        font-family:self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                    text: root.download-folder;
                    color:self.theme-paint.has-text ? self.theme-paint.text : AppColors.muted;
                    overflow: elide;
                    font-size:self.theme-paint.has-font-size ? self.theme-paint.font-size*1px : 11px;
                }
                if root.download-preparing: LoadingDots {
                    width: 22px;
                    height: 22px;
                }
                if root.download-running: Rectangle {
                    height: 4px;
                    background: AppColors.border;
                    Rectangle {
                        height: parent.height;
                        width: parent.width * clamp(root.download-progress/100,0,1);
                        background: AppColors.accent;
                    }
                }
                ThemeText {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-text";theme-kind:"text";
                        font-family:self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                    text: root.download-status;
                    color:self.theme-paint.has-text ? self.theme-paint.text : AppColors.muted;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 56px;
                    vertical-stretch: 1;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    height: 34px;
                    ActionButton {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-action";
                        label: "Download";
                        primary: true;
                        available: root.download-ready && !root.download-preparing && !root.download-running;
                        clicked=>{
                            root.start-download();
                        }
                    }
                    if root.download-preparing || root.download-running: ActionButton {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-action";
                        label: "Cancel download";
                        clicked=>{
                            root.cancel-download();
                        }
                    }
                    ActionButton {
                        theme-section:root.music-layout ? 0 : 4;theme-key:"downloads-action";
                        label: "Close";
                        clicked=>{
                            root.download-open=false;
                        }
                    }
                }
            }
        }
    }
    // Experimental empty overlay; the invisible left-edge hover strip is native.
    Rectangle {
        visible: !root.music-layout && !root.anime-mode && !root.fullscreen-mode && !root.settings-open && !root.download-open && !root.playlist-editor;
        x: 2px;
        y: (root.height - self.height) / 2;
        width: 6px;
        height: 44px;
        opacity: root.left-pane-hovered ? 0 : 1;
        animate opacity {
            duration: 120ms;
            easing: ease-out;
        }
        background: AppColors.raised;
        border-width: 1px;
        border-color: AppColors.border;
        border-radius: 3px;
        Rectangle {
            x: 2px;
            y: 13px;
            width: 2px;
            height: 18px;
            border-radius: 1px;
            background: AppColors.muted;
        }
    }
    Rectangle {
        visible: !root.music-layout && !root.anime-mode && !root.fullscreen-mode && !root.settings-open && !root.download-open && !root.playlist-editor;
        x: 0px;
        y: root.left-pane-top;
        width: 220px;
        height: max(0px, root.height - root.left-pane-top);
        clip: true;
        // A hidden panel must never intercept clicks on the video beneath it.
        opacity: root.left-pane-hovered ? 1 : 0;
        animate opacity {
            duration: 140ms;
            easing: ease-out;
        }
        Rectangle {
            x: root.left-pane-hovered ? 0px : -220px;
            y: 0px;
            width: 220px;
            height: parent.height;
            animate x {
                duration: 160ms;
                easing: ease-out;
            }
            background: AppColors.panel;
            border-width: 1px;
            border-color: AppColors.border;
            border-radius: 10px;
            if root.left-pane-hovered: Rectangle {
                width: parent.width;
                height: parent.height;
                TouchArea {
                }
                // Consume clicks on the panel background, not on its child controls.
                VerticalBox {
                    padding: 12px;
                    spacing: 10px;
                    HorizontalBox {
                        padding: 0px;
                        spacing: 4px;
                        Text {
                            text: "VIDEO PLAYLIST";
                            color: AppColors.muted;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        MusicButton {
                            width: 24px;
                            height: 26px;
                            icon-size: 16px;
                            icon: @image-url("icons/plus.svg");
                            label: "Create video playlist";
                            clicked=>{
                                root.rename-playlist=false;
                                root.playlist-name="";
                                root.playlist-editor=true;
                            }
                        }
                        MusicButton {
                            width: 24px;
                            height: 26px;
                            icon-size: 15px;
                            icon: @image-url("icons/trash.svg");
                            label: "Delete video playlist";
                            available: root.video-playlist-id!="";
                            clicked=>{
                                root.playlist-delete();
                            }
                        }
                    }
                    PlaylistPicker {
                        height: 34px;
                        label: "";
                        placeholder: "Choose playlist";
                        model: root.playlist-names;
                        current-index <=> root.save-to;
                        selected(i)=>{
                            root.playlist-select(root.playlists[i].id);
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        min-height:60px;
                        content-y <=> root.library-scroll;
                        horizontal-scrollbar-policy: always-off;
                        changed content-height=>{
                            root.library-scroll=clamp(root.library-scroll, min(0px, self.visible-height - self.content-height),0px);
                        }
                        changed visible-height=>{
                            root.library-scroll=clamp(root.library-scroll, min(0px, self.visible-height - self.content-height),0px);
                        }
                        for item[i] in root.video-playlist-rows: Rectangle {
                            height: 58px;
                            background: video-list-hit.has-hover ? AppColors.hover : transparent;
                            border-radius: 6px;
                            video-list-hit := TouchArea {
                                enabled: item.available;
                                clicked=>{
                                    root.playlist-play(i);
                                }
                            }
                            Text {
                                x: 7px;
                                y: 7px;
                                width: parent.width - 45px;
                                height: 32px;
                                text: item.title;
                                color: AppColors.text;
                                font-size: 12px;
                                wrap: word-wrap;
                                overflow: elide;
                            }

                            MusicButton {
                                width: 24px;
                                height: 25px;
                                icon-size: 14px;
                                x: parent.width - 40px;
                                y: 29px;
                                icon: @image-url("icons/trash.svg");
                                label: "Remove video from playlist";
                                clicked=>{
                                    root.playlist-remove(i);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    Rectangle {
        x: (root.width - self.width) / 2;
        width: min(380px,root.width - 40px);
        height: 48px;
        y: root.toast-visible ? root.height - 70px : root.height + 8px;
        opacity: root.toast-visible ? 1 : 0;
        animate y {
            duration: 180ms;
            easing: ease-out;
        }
        animate opacity {
            duration: 140ms;
            easing: ease-out;
        }
        background: AppColors.raised;
        border-width: 1px;
        border-color: AppColors.border;
        border-radius: 12px;
        Rectangle {
            x: 12px;
            y: 17px;
            width: 3px;
            height: 14px;
            border-radius: 2px;
            background: AppColors.accent;
        }
        Text {
            x: 26px;
            y: 0px;
            width: parent.width - 40px;
            height: parent.height;
            text: root.toast-text;
            color: AppColors.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
