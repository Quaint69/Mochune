                                                font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
                                                theme-section: 2;
                                                theme-key: "list-text-5";
                                                theme-kind: "text";
                                                theme-state: "normal";
                                                text: view-index + (root.music-artist-search && root.browse-tab == -1 && BrowsePages.channel-hits.length > 0 ? 0 : 1);
                                                color: self.theme-paint.has-text ? self.theme-paint.text : (AppColors.weak);
                                                font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (11px);
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        ThemeBox {
                                            opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
