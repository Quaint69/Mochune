import {Sources, SourceRow, ReaderPage, SourcePicker, SourcePanel, SourceSidebar, MangaReader} from "sources.slint";
export {Sources, SourceRow, ReaderPage}
import {VideoFrame} from "video-frame.slint";
import {BrowsePages, HomeSection, PageRow, ChannelRow, CommentRow, PersonalPage, ChannelHits, CommentsPanel} from "pages.slint";
export {BrowsePages, HomeSection, PageRow, ChannelRow, CommentRow}
import {ThemeScrollBar, ThemeScrollView} from "theme-scroll.slint";
import {MusicSkin, SkinImage} from "music-skin.slint";
import {MusicTheme, ThemePaint, VideoColors, ThemeBox, ThemeText, ThemeImage, ThemeInput, ThemeDecoration} from "music-theme.slint";
export {MusicTheme, ThemePaint}
export {MusicSkin}
import {CornerCutouts} from "corner-cutouts.slint";
import {SeekBar} from "seek-bar.slint";
import {BufferedRange} from "buffer-range.slint";
import "fonts/DejaVuSansMono-Bold.ttf";
import {ActionButton} from "action-button.slint";
import {TermEditor} from "term-editor.slint";
import "fonts/DejaVuSans.ttf";
import "fonts/MochuneDisplay.ttf";
import "fonts/DejaVuSans-Bold.ttf";
import {LyricsView} from "lyrics.slint";
import {PlaylistPicker} from "playlist-picker.slint";
import {LoadingDots, BrowseTab} from "loading.slint";
import {BrowseMenu} from "browse-tools.slint";
import {QualityPicker} from "quality.slint";
import {AppColors} from "theme.slint";
import {Button, LineEdit, ComboBox, CheckBox, Slider, ScrollView, ListView, VerticalBox, HorizontalBox, Palette} from "std-widgets.slint";
export struct NativeOcclusion { visible: bool, x: length, y: length, width: length, height: length }
export struct QueueCard {
    title: string, channel: string, active: bool
}
export struct PlaylistCard {
    id: string, name: string, count: string
}
export struct VideoCard {
    title: string, channel: string, detail: string, duration-text: string, views-text: string, thumbnail: image, source-id: string, downloaded: bool, available: bool, music-available: bool, unavailable-reason: string
}
component RowSkeleton inherits ThemeBox {
    border-color: root.theme-paint.replace-chrome ? transparent : root.theme-paint.has-border ? root.theme-paint.border : transparent;
    border-width: root.theme-paint.replace-chrome ? 0px : root.theme-paint.has-border-width ? root.theme-paint.border-width * 1px : 0px;
    opacity: root.theme-paint.has-opacity ? root.theme-paint.opacity : 1;
    theme-kind: "skeleton";
    in property <bool> music;
    background: root.theme-paint.replace-chrome ? transparent : root.theme-paint.has-background ? root.theme-paint.background : (AppColors.muted-surface);
    border-radius: root.theme-paint.replace-chrome ? 0px : root.theme-paint.has-radius ? root.theme-paint.radius * 1px : (7px);
    property <length> art-width: root.music ? 48px : 120px;
    ThemeBox {
        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        theme-section: root.theme-section;
        theme-key: root.theme-key + "-skeleton-surface-1";
        theme-kind: "surface";
        theme-state: root.theme-state;
        x: 8px;
        y: 10px;
        width: root.art-width;
        height: root.height - 20px;
        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (AppColors.placeholder);
        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (5px);
    }
    ThemeBox {
        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        theme-section: root.theme-section;
        theme-key: root.theme-key + "-skeleton-surface-2";
        theme-kind: "surface";
        theme-state: root.theme-state;
        x: 18px + root.art-width;
        y: 19px;
        width: max(0px,root.width - root.art-width - 38px);
        height: 9px;
        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (AppColors.border);
        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (4px);
    }
    ThemeBox {
        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        theme-section: root.theme-section;
        theme-key: root.theme-key + "-skeleton-surface-3";
        theme-kind: "surface";
        theme-state: root.theme-state;
        x: 18px + root.art-width;
        y: 39px;
        width: max(0px,(root.width - root.art-width - 38px)*0.65);
        height: 8px;
        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (AppColors.border);
        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (4px);
    }
}
component PlayerButton inherits ThemeBox {
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        theme-section: 4; theme-key: "video-control-button"; theme-kind: "button";
        theme-state: !root.available ? "disabled" : root.loading ? "loading" : root.active ? "active" : touch.pressed ? "pressed" : touch.has-hover ? "hover" : "normal";

    in property <string> label;
    in property <image> icon;
    in property <bool> available: true;
    in property <bool> loading;
    in property <bool> active;
    in property <bool> toggle-marker;
    callback clicked;
    callback activity;
    width: 34px;
    height: 32px;
    border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (4px);
    background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (root.active ? #704044 : touch.has-hover && available ? #ffffff25 : transparent);
    accessible-role: button;
    accessible-label: root.label;
    ThemeImage {
        theme-section: 4; theme-key: "video-button-icon-1"; theme-kind: "icon";

        visible: !root.loading;
        source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (root.icon);
        colorize: self.theme-paint.has-tint ? self.theme-paint.tint : (#ffffff);
        width: 22px;
        height: 22px;
        x: (parent.width - self.width)/2;
        y: (parent.height - self.height)/2;
        image-fit: contain;
        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : (root.available ? 1 : 0.4);
    }
    if root.loading: LoadingDots {
        tint: #ffffff;
        width: 22px;
        height: 18px;
        x: (parent.width - self.width)/2;
        y: (parent.height - self.height)/2;
    }
    if root.active && root.toggle-marker: Rectangle {
        x:(parent.width - self.width)/2;y:parent.height - 4px;width:12px;height:2px;
        background:root.theme-paint.has-text ? root.theme-paint.text : #ffffff;
    }
    touch := TouchArea {
        enabled: root.available;
        moved => {
            root.activity();
        }
        clicked => {
            root.activity();
            root.clicked();
        }
    }
}
component MusicButton inherits ThemeBox {
    theme-kind: "button";
    theme-state: !root.available ? "disabled" : root.active ? "active" : hit.pressed ? "pressed" : hit.has-hover ? "hover" : "normal";
    in property <image> icon;
    in property <bool> skinned;
    in property <int> skin-slot: -1;
    in property <length> icon-size: 19px;
    in property <string> label;
    in property <bool> active;
    in property <bool> toggle-marker;
    in property <bool> heart: false;
    in property <bool> repeat-one: false;
    in property <bool> available: true;
    callback clicked;
    out property <bool> hovered: hit.has-hover;
    width: 34px;
    height: 32px;
    border-radius: root.theme-paint.replace-chrome ? 0px : root.theme-paint.has-radius ? root.theme-paint.radius * 1px : (root.skinned && MusicSkin.enabled ? MusicSkin.radius * 1px : 8px);
    border-width: root.theme-paint.replace-chrome ? 0px : root.theme-paint.has-border-width ? root.theme-paint.border-width * 1px : (root.skinned && MusicSkin.enabled ? MusicSkin.border-width * 1px : 0px);
    border-color: root.theme-paint.replace-chrome ? transparent : root.theme-paint.has-border ? root.theme-paint.border : (MusicSkin.border);
    background: root.theme-paint.replace-chrome ? transparent : root.theme-paint.has-background ? root.theme-paint.background : (root.skinned && MusicSkin.enabled ? (root.active && !root.heart ? MusicSkin.accent : hit.has-hover ? MusicSkin.button-hover : MusicSkin.button) : root.active && !root.heart ? AppColors.active : hit.has-hover ? AppColors.border : transparent);
    accessible-role: button;
    accessible-label: root.label;
    opacity: root.theme-paint.has-opacity ? root.theme-paint.opacity : (root.available ? 1 : 0.35);
    // Replacing chrome also removes legacy texture (which may bake in a border).
    // The icon below remains independent, including theme-local replacements.
    if root.skinned && MusicSkin.enabled && !root.theme-paint.replace-chrome: SkinImage {
        theme-section: root.theme-section;
        theme-key: root.theme-key + "-texture";
        theme-kind: "button-texture";
        theme-state: root.theme-state;
        slot: 19;
        width: parent.width;
        height: parent.height;
    }
    SkinImage {
        theme-section: root.theme-section;
        theme-key: root.theme-key + "-icon";
        theme-state: root.theme-state;
        slot: root.skinned ? (root.heart ? (root.active ? 15 : 14) : root.skin-slot) : -1;
        fallback: root.heart && root.active ? @image-url("icons/heart-filled.svg") : root.icon;
        tint: root.heart && root.active ? (root.skinned ? MusicSkin.liked : #ed6686) : root.skinned ? MusicSkin.text : AppColors.text;
        width: root.heart && root.active ? (root.icon-size + 2px) * (root.skinned ? MusicSkin.icon-scale : 1) : root.icon-size * (root.skinned ? MusicSkin.icon-scale : 1);
        height: self.width;
        x: (parent.width - self.width)/2;
        y: (parent.height - self.height)/2;
        animate width {
            duration: 160ms;
            easing: ease-out;
        }
    }
    if root.repeat-one: ThemeText {
        opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
        theme-section: root.theme-section;
        theme-key: root.theme-key + "-music-button-text-1";
        theme-kind: "text";
        theme-state: root.theme-state;
        x: 22px;
        y: 0px;
        width: 10px;
        height: 12px;
        text: "1";
        font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (9px);
        font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : (700);
        color: self.theme-paint.has-text ? self.theme-paint.text : root.skinned ? MusicSkin.text : AppColors.text;
        horizontal-alignment: center;
    }
    if root.active && root.toggle-marker: Rectangle {
        x:(parent.width - self.width)/2;y:parent.height - 4px;width:12px;height:2px;
        background:root.skinned ? MusicSkin.text : AppColors.text;
    }
    hit := TouchArea {
        enabled: root.available;
        clicked => {
            root.clicked();
        }
    }
}
component MusicTransport inherits Rectangle {
    in property <bool> has-selection;
    in property <bool> selection-playable;
    in property <bool> resolving;
    in property <bool> paused;
    in property <float> position;
    in property <float> duration;
    in-out property <float> volume;
    in-out property <float> previous-volume;
    in-out property <bool> shuffle;
    in property <bool> repeat;
    in property <bool> repeat-one;
    in property <bool> lyrics-enabled;
    in property <bool> lyrics-available;
    in property <[string]> lyrics-languages;
    in property <int> lyrics-language-choice;
    in property <string> lyrics-language-label;
    callback toggle-pause;
    callback play;
    callback previous;
    callback next(bool);
    callback toggle-music-repeat;
    callback volume-change(float);
    callback toggle-lyrics;
    callback choose-caption(int);
    in property <bool> tight;
    property <length> inset: root.tight ? 28px : 36px;
    property <int> panel;
    height: 36px;
    Timer {
        interval: 220ms;
        running: root.panel != 0 && !hover-watch.has-hover && !language-picker.popup-open;
        triggered=>{ root.panel=0; }
    }
    hover-watch := TouchArea {
        width: parent.width; height: parent.height;
        MusicButton {
            x: 0px; y: 2px; width: 28px; height: 32px;
            changed hovered=>{ if self.hovered { root.panel=1; } }
            theme-section: 3;
            theme-key: "volume-button";
            skinned: true;
            skin-slot: root.volume > 0 ? 12 : 13;
            icon: root.volume > 0 ? @image-url("icons/volume.svg") : @image-url("icons/muted.svg");
            label: root.volume > 0 ? "Mute" : "Unmute";
            clicked=>{
                if root.volume > 0 {
                    root.previous-volume=root.volume;
                    root.volume=0;
                }
                else{
                    root.volume=root.previous-volume;
                }
                root.volume-change(root.volume);
            }
        }
        MusicButton {
            x: root.width - 28px; y: 2px;
            changed hovered=>{ if self.hovered { root.panel=2; } }
            theme-section: 3;
            theme-key: "captions-button";
            skinned: true;
            skin-slot: 18;
            icon: @image-url("icons/captions.svg");
            width: 28px;
            height: 32px;
            active: root.lyrics-enabled;
            label: root.lyrics-enabled ? "Turn lyrics off" : "Turn lyrics on";
            clicked=>{
                root.toggle-lyrics();
            }
        }
        if root.panel == 0: HorizontalBox {
            x: root.inset; width: root.width - root.inset * 2;
            padding: 0px;
            spacing: 4px;
            height: 36px;
            alignment: center;
            MusicButton {
                theme-section: 3;
                theme-key: "shuffle-button";
                width: 28px; height: 36px;
                icon: @image-url("icons/shuffle.svg");
                skinned: true;
                skin-slot: 10;
                label: "Shuffle";
                active: root.shuffle;
                clicked => {
                    root.shuffle=!root.shuffle;
                }
            }
            MusicButton {
                theme-section: 3;
                theme-key: "previous-button";
                width: 28px; height: 36px;
                icon: @image-url("icons/previous.svg");
                skinned: true;
                skin-slot: 8;
                label: "Previous";
                clicked => {
                    root.previous();
                }
            }
            ThemeBox {
                opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                theme-section: 3;
                theme-key: "play-pause-button";
                theme-kind: "button";
                theme-state: root.resolving ? "loading" : !root.has-selection ? "disabled" : play-hit.pressed ? "pressed" : play-hit.has-hover ? "hover" : root.paused ? "normal" : "active";
                width: 38px;
                height: 36px;
                border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (MusicSkin.enabled ? MusicSkin.radius * 1px : 18px);
                border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : (MusicSkin.enabled ? MusicSkin.border-width * 1px : 0px);
                border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : (MusicSkin.border);
                background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (MusicSkin.accent);
                accessible-role: button;
                accessible-label: root.paused || root.position <= 0 ? "Play" : "Pause";
                if root.resolving: LoadingDots {
                    theme-section: 3;
                    theme-key: "player-loading-1";
                    tint: #2b1806;
                    width: 22px;
                    height: 18px;
                    x: 8px;
                    y: 9px;
                }
                if !root.resolving: SkinImage {
                    theme-section: 3;
                    theme-key: root.paused || root.position <= 0 ? "play-icon" : "pause-icon";
                    theme-kind: "icon";
                    slot: root.paused || root.position <= 0 ? 6 : 7;
                    fallback: root.paused || root.position <= 0 ? @image-url("icons/play.svg") : @image-url("icons/pause.svg");
                    tint: MusicSkin.accent-text;
                    width: 22px;
                    height: 22px;
                    x: 8px;
                    y: 7px;
                }
                play-hit := TouchArea {
                    enabled: root.has-selection && root.selection-playable && !root.resolving;
                    clicked => {
                        if root.duration > 0 {
                            root.toggle-pause();
                        }
                        else {
                            root.play();
                        }
                    }
                }
            }
            MusicButton {
                theme-section: 3;
                theme-key: "next-button";
                width: 28px; height: 36px;
                icon: @image-url("icons/next.svg");
                skinned: true;
                skin-slot: 9;
                label: "Next";
                clicked => {
                    root.next(false);
                }
            }
            MusicButton {
                theme-section: 3;
                theme-key: "repeat-button";
                toggle-marker:true;
                width: 28px; height: 36px;
                skinned: true;
                skin-slot: 11;
                icon: @image-url("icons/repeat.svg");
                repeat-one: root.repeat-one;
                label: root.repeat-one ? "Repeat song · click to turn off" : root.repeat ? "Repeat list · click to repeat song" : "Repeat off · click to repeat list";
                active: root.repeat || root.repeat-one;
                clicked => {
                    root.toggle-music-repeat();
                }
            }
        }
        language-picker := PlaylistPicker {
            visible: root.panel == 2;
            x: root.inset; y: 1px; width: root.width - root.inset * 2;
            open-above: true;
            theme-section: 3;
            theme-key: "player-button-5";
            skinned: true;
            label: "Lyrics";
            accessible-name: "Lyrics language";
            model: root.lyrics-languages;
            current-index: root.lyrics-language-choice;
            placeholder: root.lyrics-available ? root.lyrics-language-label : "Unavailable";
            available: root.lyrics-available;
            horizontal-stretch: 1;
            selected(index)=>{
                root.choose-caption(index + 1);
            }
        }
        if root.panel == 1: HorizontalBox {
            x: root.inset; width: root.width - root.inset * 2; height: 36px; padding: 0px; spacing: 6px;
            Rectangle { horizontal-stretch: 1; height: 36px;
            SeekBar {
                theme-section: 3; theme-key: "volume"; skinned: true;
                accessible-name: "Volume"; accent: MusicSkin.accent;
                position: root.volume; duration: 100; x: 0px; y: 8px; width: parent.width; height: 20px;
                seek-requested(value)=>{ root.volume=value; root.volume-change(value); }
            }
            }
            ThemeText {
                theme-section: 3; theme-key: "player-text-7";
                text: round(clamp(root.volume,0,100)) + "%";
                width: 34px; vertical-alignment: center; horizontal-alignment: right;
                font-size: 10px; color: MusicSkin.muted;
            }
        }
    }
}


component MusicCacheToggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled;
    width: caption.preferred-width + 50px; height: 34px;
    accessible-role: switch; accessible-label: "Save played music";
    accessible-checkable: true; accessible-checked: root.checked;
    forward-focus: focus;
    function toggle() { root.checked=!root.checked; root.toggled(); }
    ThemeBox {
        theme-section: 2; theme-key: "save-played-music"; theme-kind: "switch";
        theme-state: root.checked ? "active" : hit.has-hover ? "hover" : "normal";
        x: 0px; y: 7px; width: 36px; height: 20px;
        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : root.checked ? AppColors.accent : AppColors.muted-surface;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : AppColors.border;
        border-width: 1px; border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 10px;
        ThemeBox {
            theme-section: 2; theme-key: "cache-switch-thumb"; theme-kind: "thumb";
            theme-state: root.checked ? "active" : "normal";
            x: root.checked ? 18px : 2px; y: 2px; width: 16px; height: 16px;
            background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : root.checked ? AppColors.window : AppColors.text;
            border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 8px;
        }
    }
    caption := ThemeText {
        theme-section: 2; theme-key: "cache-switch-label";
        x: 46px; height: parent.height; text: "Save played music";
        color: self.theme-paint.has-text ? self.theme-paint.text : AppColors.text;
        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
        font-size: 12px; vertical-alignment: center;
    }
    focus := FocusScope { key-pressed(event)=>{ if event.text==" " || event.text==Key.Return {root.toggle();return accept;} return reject;} }
    hit := TouchArea { clicked=>{focus.focus();root.toggle();} }
}

component WindowButtons inherits Rectangle {
    in property <bool> maximized;
    in property <bool> compact;
    callback minimize;
    callback restore;
    callback close;
    width: root.compact ? 78px : 96px; height: root.compact ? 28px : 36px;
    HorizontalBox { padding: 0px; spacing: 0px;
        MusicButton { theme-section: 0; theme-key: "window-minimize"; width: root.width / 3; height: root.height;
            icon-size: 16px; label: "Minimize"; icon: @image-url("icons/minimize.svg"); clicked => { root.minimize(); } }
        MusicButton { theme-section: 0; theme-key: "window-maximize"; width: root.width / 3; height: root.height;
            icon-size: 16px; label: root.maximized ? "Restore" : "Maximize";
            icon: root.maximized ? @image-url("icons/restore.svg") : @image-url("icons/maximize.svg"); clicked => { root.restore(); } }
        MusicButton { theme-section: 0; theme-key: "window-close"; width: root.width / 3; height: root.height;
            icon-size: 16px; label: "Close"; icon: @image-url("icons/close.svg"); clicked => { root.close(); } }
    }
}
export component SetupWindow inherits Window {
    title: "Mochune";
    icon: @image-url("assets/logo-128.png");
    // The native backend supplies a decoded icon, including taskbar identity.
    in-out property <bool> immersive: true;
    in-out property <bool> launch-maximized: true;
    in-out property <bool> music-extra-card: true;
    out property <bool> anime-mode: Sources.mode > 0;
    out property <string> anime-status: Sources.status;
    callback anime-mode-change(bool);
    anime-mode-change(enabled)=>{Sources.select-mode(enabled ? 1 : 0);}
    callback anime-search(string);
    anime-search(query)=>{Sources.search(query);}
