                                                overflow: elide;
                                                wrap: word-wrap;
                                                max-lines: 2;
                                                max-height: 34px;
                                                vertical-stretch: 0;
                                                min-width: 0px;
                                                font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (13px);
                                            }
                                            ThemeText {
                                                opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : 1;
                                                font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
