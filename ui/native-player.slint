    out property <length> quality-y: quality-menu.absolute-position.y;
    out property <length> quality-popup-x: quality-menu.popup-x;
    out property <length> quality-popup-y: quality-menu.popup-y;
    out property <bool> menu-active: quality-menu.popup-open || caption-menu.popup-open || interpolation-menu.popup-open;
    callback scroll-popup(float) -> bool;
    scroll-popup(delta)=>{return interpolation-menu.native-scroll(delta) || quality-menu.native-scroll(delta) || caption-menu.native-scroll(delta);}
    callback popup-pointer(float,float,bool) -> bool;
    popup-pointer(x,y,pressed)=>{return interpolation-menu.native-pointer(x,y,pressed) || quality-menu.native-pointer(x,y,pressed) || caption-menu.native-pointer(x,y,pressed);}
    callback dismiss-menus();
    dismiss-menus=>{quality-menu.close();caption-menu.close();interpolation-menu.close();keys.focus();}
    callback global-key(string);
    callback focus-request();
    focus-request=>{keys.focus();}
    forward-focus: keys;
    keys := FocusScope {
        width: root.width; height: root.height;
        key-pressed(event)=>{root.global-key(event.text);return accept;}
                        // TouchArea.moved is a drag callback. Track hover coordinates on
                        // the parent so movement also works over the child controls.
                        TouchArea {
                            width: parent.width; height: parent.height;
                            changed mouse-x => { if self.has-hover { root.player-activity(); } }
                            changed mouse-y => { if self.has-hover { root.player-activity(); } }
                        ThemeBox {
        border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 0px;
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : transparent;
        theme-section: 4; theme-key: "video-native-surface-2"; theme-kind: "surface";

                            x: 0px; y: 0px;
                            width: parent.width; height: parent.height - (root.controls-over-video ? 0px : 72px);
                        Image { visible: false; source: root.video-frame; image-fit: contain; width: parent.width; height: parent.height; }
                        TouchArea {
                            moved => {root.player-activity();}
                            clicked => {root.focus-request();root.player-click();}
                            double-clicked => {root.player-double-click(self.mouse-x / self.width);}
                        }
                        caption-measure := ThemeText {
        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
        font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
        theme-section: 4; theme-key: "video-native-text-1"; theme-kind: "text";
text: root.caption-text; font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (18px); wrap: no-wrap; visible: false;}
                        caption-next-measure := ThemeText {
        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
        font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
