        theme-section: 4; theme-key: "video-native-surface-5"; theme-kind: "surface";

                            width: 64px; height: 64px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                            background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (#000000a0); border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (32px);
                            LoadingDots { theme-section: 4; theme-key: "video-loadingdots"; width: 32px; height: 32px; x: 16px; y: 16px; }
                        }
                        if root.has-selection && !root.resolving && ((!root.video-visible && root.position <= 0) || root.paused): ThemeBox {
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        theme-section: 4; theme-key: "video-native-surface-6"; theme-kind: "surface";

                            width: 58px; height: 58px; x: (parent.width - self.width) / 2; y: (parent.height - self.height - 40px) / 2;
                            background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (#000000a0); border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (29px);
                            ThemeImage {
        image-rendering: self.theme-paint.pixelated ? pixelated : smooth;
        theme-section: 4; theme-key: "video-native-artwork-1"; theme-kind: "icon";
source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (@image-url("icons/play.svg")); width: 32px; height: 32px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; image-fit: contain;colorize: self.theme-paint.image.width > 0 ? transparent : self.theme-paint.has-tint ? self.theme-paint.tint : transparent; }
                            TouchArea {enabled: root.selection-playable; clicked => { root.focus-request(); if root.position > 0 { root.toggle-pause(); } else { root.play(); } } }
                        }

                        }
                                            ThemeBox {
        decorate: !root.controls-over-video;
        border-radius: root.controls-over-video ? 0px : self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : 0px;
        border-width: root.controls-over-video ? 0px : self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: root.controls-over-video ? transparent : self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        theme-section: 4; theme-key: "video-controls"; theme-kind: "surface";

                            visible: !root.controls-over-video || root.controls-shown || !root.video-visible || root.paused || root.resolving || quality-menu.popup-open || caption-menu.popup-open || interpolation-menu.popup-open;
                            height: 72px; width: parent.width; y: parent.height - self.height;
                            background: root.controls-over-video ? @linear-gradient(180deg, #00000000, #000000c0 35%, #000000ed) : (self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (root.controls-over-video ? @linear-gradient(180deg, #00000000, #000000c0 35%, #000000ed) : #171717));
                            // Consume gaps/padding too; only the picture toggles playback.
