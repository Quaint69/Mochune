        theme-section: 4; theme-key: "video-native-text-5"; theme-kind: "text";
text: root.seek-feedback; color: self.theme-paint.has-text ? self.theme-paint.text : (#ffffff); font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (18px); horizontal-alignment: center; vertical-alignment: center;}
