 text: "Search for a video to get started"; color: self.theme-paint.has-text ? self.theme-paint.text : (AppColors.muted); horizontal-alignment: center; vertical-alignment: center; }
                        if root.resolving: ThemeBox {
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
