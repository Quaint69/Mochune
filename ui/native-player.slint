        theme-section: 4; theme-key: "video-native-text-3"; theme-kind: "text";
text: root.caption-text; color: self.theme-paint.has-text ? self.theme-paint.text : (#ffffff); font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (18px); wrap: no-wrap; horizontal-alignment: center; vertical-alignment: center; x: 12px; y: 6px; width: parent.width - 24px; height: 23px; overflow: elide;}
                            ThemeText {
        font-family: self.theme-paint.has-font-family ? self.theme-paint.font-family : "DejaVu Sans";
        font-weight: self.theme-paint.has-font-weight ? self.theme-paint.font-weight : 400;
        theme-section: 4; theme-key: "video-native-text-4"; theme-kind: "text";
text: root.caption-next; color: self.theme-paint.has-text ? self.theme-paint.text : (#ffffffb8); font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (17px); wrap: no-wrap; horizontal-alignment: center; vertical-alignment: center; x: 12px; y: 29px; width: parent.width - 24px; height: 23px; overflow: elide;}
                        }
                        if root.seek-feedback != "": ThemeBox {
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        theme-section: 4; theme-key: "video-native-surface-4"; theme-kind: "surface";
width: 88px; height: 56px; x: root.seek-feedback-right ? parent.width * 0.75 - 44px : parent.width * 0.25 - 44px; y: (parent.height - 56px) / 2; background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (#000000b8); border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (28px);
                            ThemeText {
