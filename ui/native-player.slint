import {MusicTheme, ThemeBox, ThemeText, ThemeImage, ThemeInput} from "music-theme.slint";
import {SeekBar} from "seek-bar.slint";
import {BufferedRange} from "buffer-range.slint";
// Native Windows overlay counterpart of setup.slint player controls.
// Keep controls/caption behavior in sync; video pixels are never rendered here.
import {AppColors} from "theme.slint";
import {LoadingDots} from "loading.slint";
import {QualityPicker} from "quality.slint";
import {Slider,HorizontalBox,VerticalBox} from "std-widgets.slint";
component PlayerButton inherits ThemeBox {
        border-width: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-border-width ? self.theme-paint.border-width * 1px : 0px;
        border-color: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-border ? self.theme-paint.border : transparent;
        theme-section: 4; theme-key: "video-control-button"; theme-kind: "button";
        theme-state: !root.available ? "disabled" : root.loading ? "loading" : root.active ? "active" : touch.pressed ? "pressed" : touch.has-hover ? "hover" : "normal";

    in property <string> label;
    in property <image> icon;
    in property <bool> available: true;
    in property <bool> loading;
    in property <bool> active;
    in property <bool> toggle-marker;
    callback clicked;
    callback activity;
    width: 34px; height: 32px; border-radius: self.theme-paint.replace-chrome ? 0px : self.theme-paint.has-radius ? self.theme-paint.radius * 1px : (4px);
    background: self.theme-paint.replace-chrome ? transparent : self.theme-paint.has-background ? self.theme-paint.background : (root.active ? #704044 : touch.has-hover && available ? #ffffff25 : transparent);
    accessible-role: button; accessible-label: root.label;
    ThemeImage {
        theme-section: 4; theme-key: "video-native-icon-1"; theme-kind: "icon";
visible: !root.loading; source: self.theme-paint.image.width > 0 ? self.theme-paint.image : (root.icon); colorize: self.theme-paint.has-tint ? self.theme-paint.tint : (#ffffff); width: 22px; height: 22px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; image-fit: contain; opacity: self.theme-paint.has-opacity ? self.theme-paint.opacity : (root.available ? 1 : 0.4);}
    if root.loading: LoadingDots { theme-section: 4; theme-key: "video-loadingdots";tint: #ffffff; width: 22px; height: 18px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;}
    if root.active && root.toggle-marker: Rectangle {
        x:(parent.width - self.width)/2;y:parent.height - 4px;width:12px;height:2px;
        background:root.theme-paint.has-text ? root.theme-paint.text : #ffffff;
    }
    touch := TouchArea { enabled: root.available; moved => { root.activity(); } clicked => { root.activity(); root.clicked(); } }
}

export {MusicTheme}
export component NativePlayerOverlay inherits Window {
    preferred-width: 900px; preferred-height: 506px; background: transparent;
    out property <length> canvas-width: root.width;
