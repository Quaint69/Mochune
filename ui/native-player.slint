        theme-section: 4; theme-key: "video-native-text-7"; theme-kind: "text";
 text: root.clock; color: root.controls-over-video ? #ffffff : self.theme-paint.has-text ? self.theme-paint.text : (#ffffff); font-size: self.theme-paint.has-font-size ? self.theme-paint.font-size * 1px : (root.width < 560px ? 10px : 12px); vertical-alignment: center; }
                                    ThemeBox {
