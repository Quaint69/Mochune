                                        mute-touch := TouchArea { moved => {root.player-activity();} clicked => {root.player-activity();if root.volume > 0 {root.previous-volume=root.volume;root.volume=0;}else{root.volume=root.previous-volume;}root.volume-change(root.volume);} }
